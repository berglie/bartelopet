{
  "name": "bartelopet",
  "version": "1.7.3",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "undici@<6.23.0": "6.23.0",
      "postcss-selector-parser": "^7.1.6"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
